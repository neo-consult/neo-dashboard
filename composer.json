{
    "name": "neo/dashboard-core",
    "description": "Core framework for the Neo WordPress dashboard.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "NeoDashboard\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeoDashboard\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:contract": "phpunit --testsuite contract"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
